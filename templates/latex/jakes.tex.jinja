\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

% Ensure that generate pdf is machine readable/ATS parsable (pdfTeX only;
% guarded so the template also compiles under tectonic's XeTeX engine, which
% lacks \pdfgentounicode and would otherwise error on the unguarded form).
\ifdefined\pdfgentounicode
  \input{glyphtounicode}
  \pdfgentounicode=1
\fi

%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[4]{
    \vspace{-2pt}\item
    \begin{tabularx}{0.97\textwidth}{@{}>{\raggedright\arraybackslash}Xr@{}}
      \textbf{\small #1} & \small #2 \\
      \textit{\footnotesize #3} & \footnotesize #4 \\
    \end{tabularx}\vspace{-7pt}
}

\newcommand{\resumeProjectSingleHeading}[2]{
    \vspace{-2pt}\item
    \begin{tabularx}{0.97\textwidth}{@{}>{\raggedright\arraybackslash}Xr@{}}
      \small #1 & \small #2 \\
    \end{tabularx}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%


\begin{document}

%----------HEADING----------
\begin{center}
    \BLOCK{ if name }
    \textbf{\Huge \scshape \VAR{ name }} \\ \vspace{1pt}
    \BLOCK{ endif }
    \BLOCK{ if contact_line }
    \small \VAR{ contact_line }
    \BLOCK{ endif }
\end{center}

\BLOCK{ if education }
%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
  \BLOCK{ for e in education }
    \resumeSubheading
      {\VAR{ e.institution or '' }}{\VAR{ e.dates or '' }}
      {\VAR{ e.degree or '' }}{\VAR{ e.score or '' }}
  \BLOCK{ endfor }
  \resumeSubHeadingListEnd
\BLOCK{ endif }

\BLOCK{ if work }
%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
  \BLOCK{ for w in work }
    \resumeSubheading
      {\VAR{ w.position or '' }}{\VAR{ w.dates or '' }}
      {\VAR{ w.name or '' }}{\VAR{ w.location or '' }}
      \BLOCK{ if w.highlights }
      \resumeItemListStart
        \BLOCK{ for h in w.highlights }
        \resumeItem{\VAR{ h }}
        \BLOCK{ endfor }
      \resumeItemListEnd
      \BLOCK{ endif }
  \BLOCK{ endfor }
  \resumeSubHeadingListEnd
\BLOCK{ endif }

\BLOCK{ if projects }
%-----------PROJECTS-----------
\section{Projects}
  \resumeSubHeadingListStart
  \BLOCK{ for p in projects }
    \BLOCK{ if p.has_primary and p.has_meta }
    \resumeProjectHeading
      {\VAR{ p.name or '' }}{\VAR{ p.dates or '' }}
      {\VAR{ p.tech_line or '' }}{\VAR{ p.link or '' }}
    \BLOCK{ elif p.has_primary }
    \resumeProjectSingleHeading
      {\textbf{\VAR{ p.name or '' }}}{\VAR{ p.dates or '' }}
    \BLOCK{ elif p.has_meta }
    \resumeProjectSingleHeading
      {\emph{\VAR{ p.tech_line or '' }}}{\VAR{ p.link or '' }}
    \BLOCK{ endif }
      \BLOCK{ if p.highlights }
      \resumeItemListStart
        \BLOCK{ for h in p.highlights }
        \resumeItem{\VAR{ h }}
        \BLOCK{ endfor }
      \resumeItemListEnd
      \BLOCK{ endif }
  \BLOCK{ endfor }
  \resumeSubHeadingListEnd
\BLOCK{ endif }

\BLOCK{ if skills }
%-----------PROGRAMMING SKILLS-----------
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
    \BLOCK{ for s in skills }
    \BLOCK{ if s.name and s.keywords_line }
     \textbf{\VAR{ s.name }}{: \VAR{ s.keywords_line }} \\
    \BLOCK{ elif s.name }
     \textbf{\VAR{ s.name }} \\
    \BLOCK{ elif s.keywords_line }
     \VAR{ s.keywords_line } \\
    \BLOCK{ endif }
    \BLOCK{ endfor }
    }}
 \end{itemize}
\BLOCK{ endif }

%-------------------------------------------
\end{document}
