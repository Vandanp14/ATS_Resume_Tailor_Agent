# LLM Provider Configuration
# Options: "ollama" or "gemini"
LLM_PROVIDER=gemini

# Default model to use.
# Primary target for the tailoring pipeline (a weak, cheap model — the
# templates and schema-constrained decoding are tuned for reliability at
# this tier). For Ollama instead, use e.g. "gemma3:4b".
DEFAULT_MODEL=gemini-3.1-flash-lite

# Google Gemini API Key (required if using the Gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here
