# LLM Provider Configuration
# Options: "ollama" or "gemini"
LLM_PROVIDER=gemini

# Default model to use.
# Primary target for the tailoring pipeline (a weak, cheap model — the
# templates and schema-constrained decoding are tuned for reliability at
# this tier). For Ollama instead, use e.g. "gemma3:4b".
DEFAULT_MODEL=gemini-3.1-flash-lite

# Google Gemini API Key (required if using the Gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Reasoning-heavy stages (requirement coverage, selection, evidence planning,
# holistic review) try these models first, in order, then DEFAULT_MODEL.
# Leave empty to run every stage on DEFAULT_MODEL.
PLANNING_MODELS=gemini-3.8-flash,gemini-3.5-flash

# OpenRouter (cheap, reliable primary; Gemini becomes the backup).
# Any model id prefixed "openrouter/" uses this key, and can be mixed with
# Gemini models in the chains below. Recommended setup:
#   DEFAULT_MODEL=openrouter/deepseek/deepseek-v4.1-flash
#   PLANNING_MODELS=openrouter/deepseek/deepseek-v4.1-flash
#   FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Company research (web search) always runs on the first Gemini model listed.
OPENROUTER_API_KEY=
# OPENROUTER_TIMEOUT_MS=120000

# FreeLLMAPI (local OpenAI-compatible proxy, github.com/tashfeenahmed/freellmapi).
# When the key is set and the container is running, the New tailoring form
# offers per run: Gemini (the chain above), FreeLLMAPI only, FreeLLMAPI first
# with Gemini fallback, or Gemini first with FreeLLMAPI as the last fallback.
# CLI: --provider freellm|freellm-gemini|gemini-freellm [--freellm-model auto].
# A stopped container or bad proxy key falls back to Gemini in the mixed modes.
FREELLMAPI_API_KEY=
# FREELLMAPI_BASE_URL=http://localhost:3001/v1
# FREELLMAPI_MODEL=auto
# FREELLMAPI_TIMEOUT_MS=120000

# Tried after DEFAULT_MODEL when it is overloaded (503), rate-limited (429),
# or retired (404). If every model in a stage's chain fails, the run stops and
# reports exactly what the Gemini API returned for each model.
FALLBACK_MODELS=gemini-3.5-flash-lite

# Per-request Gemini timeout in milliseconds. Planning prompts carry the whole
# master fact bank; slow or timed-out models fall back like overloaded ones.
GEMINI_TIMEOUT_MS=120000

# Privacy: personal data never reaches any model. Name, email, phone, address,
# profile URLs/handles, references and every URL/location field are stripped or
# replaced with placeholders before a call and restored by code afterwards.
# Extra terms to keep private (one per line, e.g. a confidential client or
# salary figure) go in this file; it is gitignored.
# PRIVATE_TERMS_FILE=private_terms.txt

# Writing stages (JD parse, skills, work/project rewrites) try these first.
# WRITING_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# One-bullet fixes (concision, regeneration) try these first.
# FIX_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Requests per minute per model; unlisted models use 10.
# MODEL_RPM=gemini-3.7-flash=10,gemini-3.5-flash-lite=15
